# Public canonical domain. Set before building for deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only feedback delivery. Never prefix these with NEXT_PUBLIC_.
# Create a sending-only Resend key restricted to your verified domain.
RESEND_API_KEY=
# Example: VoicePaste Feedback <feedback@your-verified-domain.example>
FEEDBACK_FROM=
# Set to the agreed feedback recipient; never accept recipients from the form.
FEEDBACK_TO=
