{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicepaste.local/schemas/registry.schema.json",
  "type": "object",
  "required": ["version", "updated_at", "models"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "updated_at": { "type": "string" },
    "providers": {
      "type": "array",
      "description": "Provider layer (v21+). Absent in v20 data.",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "capabilities"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "name_en": { "type": "string" },
          "kind": { "type": "string", "enum": ["online", "local"] },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["asr", "llm"] }
          },
          "docs_url": { "type": "string" },
          "credentials": {
            "type": "object",
            "description": "Credential field declarations keyed by scope: shared | asr | llm.",
            "additionalProperties": {
              "type": "object",
              "required": ["fields"],
              "additionalProperties": false,
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["key"],
                    "additionalProperties": false,
                    "properties": {
                      "key": { "type": "string" },
                      "type": { "type": "string", "enum": ["text", "password"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": {
          "type": "object",
          "description": "Shared ASR defaults applied before model-specific defaults.",
          "additionalProperties": true
        },
        "vad": {
          "type": "object",
          "description": "Shared VAD defaults applied before silero-vad defaults.",
          "additionalProperties": true
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "category", "engine", "name", "description", "languages"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["online", "offline"] },
          "category": { "type": "string", "enum": ["asr", "vad", "punctuation", "llm"] },
          "engine": { "type": "string" },
          "provider": {
            "type": "string",
            "description": "Owning provider id (see providers[].id). Absent in legacy v20 data."
          },
          "name": { "type": "string" },
          "name_en": {
            "type": "string",
            "description": "Optional English display name; falls back to name."
          },
          "description": { "type": "string" },
          "description_en": {
            "type": "string",
            "description": "Optional English description; falls back to description."
          },
          "languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "capabilities": {
            "type": "object",
            "required": ["streaming", "hotwords", "punctuation", "itn"],
            "additionalProperties": false,
            "properties": {
              "streaming": { "type": "boolean" },
              "hotwords": { "type": "boolean" },
              "punctuation": { "type": "boolean" },
              "itn": { "type": "boolean" }
            }
          },
          "requires_config": {
            "type": "array",
            "description": "Online models only: config keys the user must fill.",
            "items": { "type": "string" }
          },
          "architecture": { "type": "string" },
          "download_url": { "type": "string" },
          "file_size": { "type": "integer" },
          "mem_size": { "type": "integer" },
          "model_files": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "default_config": {
            "type": "object",
            "description": "Model-specific default config. Merged on top of defaults.asr.",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
